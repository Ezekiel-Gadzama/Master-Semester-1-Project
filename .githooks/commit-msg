#!/bin/sh
# Strip AI-agent contributor trailers. Human Co-authored-by lines are kept.
msgfile="$1"
tmp="${msgfile}.$$"
trap 'rm -f "$tmp"' EXIT

grep -viE '^Co-authored-by:.*(Cursor|Claude|Copilot|ChatGPT|OpenAI|Anthropic|Composer|Gemini|Codex|cursoragent)' "$msgfile" \
  | grep -viE '^Signed-off-by:.*(Cursor|Claude|Copilot|ChatGPT|OpenAI|Anthropic|Composer|Gemini|Codex|cursoragent)' \
  | grep -viE '^(Made-with|Generated-By|Generated by)[[:space:]]*:' \
  > "$tmp" || true

# Drop trailing blank lines left after removing trailers
awk 'BEGIN{n=0} {lines[++n]=$0} END{while(n>0 && lines[n] ~ /^[[:space:]]*$/) n--; for(i=1;i<=n;i++) print lines[i]}' "$tmp" > "$msgfile"
